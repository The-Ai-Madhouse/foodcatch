# Copy to .env and fill in. Never commit .env.
# See docs/architecture.md §8 and docs/setup.md.

# --- Pipeline -------------------------------------------------------------
# Owner connection. Local: docker compose. Production: Neon (owner role, sslmode=require).
DATABASE_URL=postgresql+psycopg://foodcatch:foodcatch@localhost:5432/foodcatch

# Raw API payloads. Local directory, or s3://<bucket>/raw for Backblaze B2.
RAW_STORE_URL=file://./data/raw
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# Salling Group developer API (https://developer.sallinggroup.com)
SALLING_API_KEY=

# Where detailed food-waste listings are kept: "lat,lon;lat,lon" and radius in km.
REGION_CENTERS=55.6761,12.5683
REGION_RADIUS_KM=30

# Optional monitoring
HEALTHCHECKS_URL_SALLING_STORES=
HEALTHCHECKS_URL_SALLING_FOOD_WASTE=
HEALTHCHECKS_URL_TJEK_STORES=
HEALTHCHECKS_URL_TJEK_OFFERS=
HEALTHCHECKS_URL_REMA_PRODUCTS=
HEALTHCHECKS_URL_OFF_ENRICH=
SENTRY_DSN=
DB_SIZE_BUDGET_MB=1024
# Products looked up in Open Food Facts per off-enrich run (1-10000). At the client's
# 1.5 requests/s, 500 take about 6 minutes.
OFF_BATCH_SIZE=500
# A job run whose record count drops by more than this fraction vs. the previous
# successful run is marked "degraded" (non-zero exit).
QUALITY_DROP_THRESHOLD=0.5
# Logging: LOG_FORMAT=auto (JSON in CI / when not a terminal), json or console.
LOG_LEVEL=INFO
LOG_FORMAT=auto

# --- Web ------------------------------------------------------------------
# The web app reads these from web/.env.local (not from this file); see web/README.md.
# Read-only login (production: a role created IN ROLE web_readonly, docs/setup.md §1.3).
# Locally, `pnpm db:seed` (in web/) creates the read-only login foodcatch_web/foodcatch_web,
# a member of web_readonly, e.g.
#   WEB_DATABASE_URL=postgres://foodcatch_web:foodcatch_web@localhost:5432/foodcatch_web_dev
# The owner role below also works locally (the app opens read-only sessions anyway).
WEB_DATABASE_URL=postgresql://foodcatch:foodcatch@localhost:5432/foodcatch
# Default location when the user has not chosen one: "lat,lon"
FOODCATCH_DEFAULT_LOCATION=55.6761,12.5683
